# Скопируйте этот файл в `.env` и заполните SECRET_KEY.
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./roastroad.db
ACCESS_TOKEN_MINUTES=30
# CORS: JSON-массив origin. По умолчанию пусто — фронт раздаётся с того же origin.
CORS_ORIGINS=[]
